# otevru.cz — Apache rules for static FTP hosting.
# Upload this folder's CONTENTS to web root (not the ftp folder itself).

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Existing files and folders (/_next, /api, images, …).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /kontakt -> kontakt.html (flat Next.js export)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|ico|png|gif|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# FORM_SECRET=your-random-secret-min-16-chars
# FORM_ALLOWED_ORIGINS=https://www.otevru.cz
#
# Turnstile — production keys from Cloudflare dashboard (Widgets):
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
#
# Cloudflare Web Analytics (optional): Dashboard → Analytics → Web Analytics
# NEXT_PUBLIC_CF_BEACON_TOKEN=your-beacon-token
#
# FTP build bakes the site key into ftp/*.html:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=... npm run build:ftp
# Without production key, build uses test keys from .env.development (local preview).
# Set turnstileSecretKey in ftp/api/config.php on the server.
#
# SMTP — required for production form delivery (e.g. Aruba, Seznam, Gmail SMTP):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=OTEVŘU web <patrik@otevru.cz>

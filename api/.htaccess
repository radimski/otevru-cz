# Only form.php is an endpoint. Everything else here — config.php with the
# SMTP password, forms.json, lib/, data/, and anything a later copy drops in —
# is denied. An allow-list, so a new file is closed until someone opens it.
<IfModule mod_authz_core.c>
    Require all denied
    <Files "form.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "form.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # A RewriteEngine here switches the site root's rules off for /api, the
    # HTTPS redirect included, so it is repeated. Not "RewriteOptions Inherit":
    # the root's pretty-URL rules do not belong under /api.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    RewriteRule ^lib/ - [F,L]
    RewriteRule ^data/ - [F,L]
</IfModule>

# Submissions are not content.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"

    # Tighter than the site-wide policy one directory up, and it overrides it.
    # These endpoints return JSON, CSV or plain text and nothing else, so a
    # response from here has no business loading anything at all. If a bug ever
    # let markup through, 'none' is what stops it doing damage.
    Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; sandbox"

    # A booking URL can carry a form id; never leak it to another site.
    Header always set Referrer-Policy "no-referrer"

    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), publickey-credentials-get=(), usb=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
